{
  "name": "rift-gambit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build-storybook": "storybook build",
    "ci:check": "npm run format && npm run lint:tsc && npm run test:coverage && npm run build",
    "db:push": "prisma format && prisma validate && prisma db push",
    "dev": "next dev",
    "format": "prettier --write .",
    "knip": "knip",
    "lint": "next lint",
    "lint:ci": "next lint --format=checkstyle -o checkstyle-result.xml",
    "lint:fix": "next lint --fix",
    "lint:tsc": "npm run type:check && npm run lint",
    "postinstall": "prisma generate",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "type:check": "tsc --noEmit --strict true",
    "upgrade:interactive": "ncu --interactive --format group"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.21.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "i18next": "^23.16.4",
    "jotai": "^2.10.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "next-auth": "^4.24.10",
    "next-intl": "^3.23.5",
    "next-themes": "^0.3.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.1.0",
    "@storybook/addon-essentials": "^8.3.6",
    "@storybook/addon-interactions": "^8.3.6",
    "@storybook/addon-links": "^8.3.6",
    "@storybook/nextjs": "^8.3.6",
    "@storybook/react": "^8.3.6",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "eslint-plugin-storybook": "^0.10.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^5.34.0",
    "npm-check-updates": "^17.1.6",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^5.21.1",
    "storybook": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
